---
interface Props {
  id: string;
  title: string;
  start?: number;
}

const { id, title, start } = Astro.props;
const startQuery = start ? `?start=${start}` : '';
---

<div class="embed youtube">
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}${startQuery}`}
    title={title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
  ></iframe>
</div>
